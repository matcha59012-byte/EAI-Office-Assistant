# ===== E-AI Office Assistant 环境配置 =====
# 复制本文件为 .env，并填入真实值。.env 已被 gitignore，禁止提交。

# DeepSeek API（必填）
DEEPSEEK_API_KEY="sk-xxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 数据库（留空则自动锚定 backend/app.db）
DATABASE_URL=""

# 向量库（留空则自动锚定 backend/chroma_data）
CHROMA_PATH=""

# 服务
BACKEND_PORT=8000
FRONTEND_ORIGIN="http://127.0.0.1:5173"

# 角色控制：true=管理员（可上传/删除文档），false=员工只读
APP_IS_ADMIN=false

# LLM 调用参数
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
